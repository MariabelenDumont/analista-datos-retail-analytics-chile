		lineageTag: 85abae25-4e14-4cfc-8dc9-6b67bf754b5b

	measure 'Uplift vs Día Normal' =
			
			VAR ticket_evento =
			    CALCULATE(
			        [Ticket Promedio],
			        dim_tiempo[evento_comercial] <> "Normal"
			    )
			VAR ticket_normal =
			    CALCULATE(
			        [Ticket Promedio],
			        dim_tiempo[evento_comercial] = "Normal"
			    )
			RETURN
			    DIVIDE(ticket_evento - ticket_normal, ticket_normal) * 100
		lineageTag: 8abda94b-1b91-4429-ba27-2cf1bec443f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Ventas Importados' = ```
			
			        DIVIDE(
