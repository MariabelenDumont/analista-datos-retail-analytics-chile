	measure 'Ventasf %YoY' = ```
			
			        VAR pct = [Ventas YoY%]
			        RETURN
			            IF(
			                ISBLANK(pct),
			                "Sin comparativo",
			                IF(
			                    pct >= 0,
			                    "▲ " & FORMAT(pct, "0.0%"),
			                    "▼ " & FORMAT(ABS(pct), "0.0%")
			                )
			            )
			```
		displayFolder: Ventas
		lineageTag: 7f35e0a7-15b0-488b-8325-cff5a4424620

	measure 'Órdenes Año Anterior' = ```
			
			        CALCULATE(
			            [Número de Órdenes],
