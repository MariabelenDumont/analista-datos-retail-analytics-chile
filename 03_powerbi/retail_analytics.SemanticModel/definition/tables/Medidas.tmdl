	measure 'Ventas Texto Formato' = ```
			
			        VAR v = [Ventas Totales]
			        RETURN
			            IF(
			                v >= 1000000000,
			                "$" & FORMAT(DIVIDE(v, 1000000000), "0.0") & "B",
			                "$" & FORMAT(DIVIDE(v, 1000000), "0") & "M"
			            )
			```
		displayFolder: Ventas
		lineageTag: 2b2e7d70-71ed-4711-ae35-05b89e0be433

	measure 'Título Dinámico Período' = ```
			
			"Periodo Seleccionado " &
			        FORMAT(MIN(dim_tiempo[fecha]), "MMM YYYY")
			        
			            & " hasta "
			            & FORMAT(MAX(dim_tiempo[fecha]), "MMM YYYY")
			```
		lineageTag: 103a157a-446e-4d76-beb6-7c3e12135ea7

	measure 'Color KPI YoY ventas' = ```
			
			        IF([Ventas YoY%] >= 0, "#5aaa6e", "#e05c6a")
			```
