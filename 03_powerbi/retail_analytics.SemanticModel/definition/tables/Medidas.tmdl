	measure '% Ventas sobre Total' = ```
			
			        DIVIDE(
			            [Ventas Totales],
			            CALCULATE([Ventas Totales], ALLSELECTED(dim_cliente[segmento_rfm]) )
			        )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Ventas
		lineageTag: 96f4bed4-7b3e-43be-b927-4a5736161fad

	measure '% Acumulado Pareto' = ```
			
				VAR TotalVentas = CALCULATE( SUM(fact_ventas[monto_total_clp]), ALL(dim_producto) )
				
				VAR VentasActual = SUM(fact_ventas[monto_total_clp])
				
			    VAR TablaResumen =
			        SUMMARIZE(
			            ALLSELECTED(fact_ventas),
			            dim_producto[nombre],
			            "@ventas", SUM(fact_ventas[monto_total_clp])
			        )
			
			    VAR Acumulado =
			        SUMX(
			            FILTER( TablaResumen, [@ventas] >= VentasActual ),
			            [@ventas]
			        )
				RETURN
					DIVIDE(acumulado,TotalVentas )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Pareto
		lineageTag: bf55441b-79b0-458a-8eb5-4668c98e3a55

	measure 'Clasificación ABC' = ```
			
			        VAR pct = [% Acumulado Pareto]
			        RETURN
			            SWITCH(
			                TRUE(),
			                pct <= 0.80, "A",
			                pct <= 0.95, "B",
			                "C"
			            )
			```
		displayFolder: Pareto
		lineageTag: aa7fa30b-78de-43a9-8b77-426d5532b80f

